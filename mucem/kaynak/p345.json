 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مَوْجَة", "cogul": "مَوْج ، أَمْواج", "metin": "مَوْج (ج) أَمْواج : (١) ما يَرْتَفِعُ مِنْ ماءِ البِحارِ وَالأَنْهارِ وَيَتَتابَعُ ، “أَلْقَتْ أَمْواجُ البَحْرِ السَّفينَةَ إِلى البَرِّ” ، ﴿وَجَاءَهُمُ الْمَوْجُ مِنْ كُلِّ مَكَانٍ﴾ . (٢) مَوْجَةُ الرّاديو وَاللاّسِلْكِيِّ : الذَّبْذَباتُ الَّتي تَنْتَقِلُ مِنَ الفَضاءِ وَالإِذاعَة ، “يَتِمُّ بَثُّ الإِرْسالِ عَلى مَوْجَةٍ مُتَوَسِّطَة” .", "tanim": "(١) ما يَرْتَفِعُ مِنْ ماءِ البِحارِ وَالأَنْهارِ وَيَتَتابَعُ (٢) مَوْجَةُ الرّاديو وَاللاّسِلْكِيِّ : الذَّبْذَباتُ الَّتي تَنْتَقِلُ مِنَ الفَضاءِ وَالإِذاعَة", "ornekler": ["“أَلْقَتْ أَمْواجُ البَحْرِ السَّفينَةَ إِلى البَرِّ”", "﴿وَجَاءَهُمُ الْمَوْجُ مِنْ كُلِّ مَكَانٍ﴾", "“يَتِمُّ بَثُّ الإِرْسالِ عَلى مَوْجَةٍ مُتَوَسِّطَة”"], "bosluk": {"cumle": "يَتِمُّ بَثُّ الإِرْسالِ عَلى مَوْجَةٍ مُتَوَسِّطَة", "kelime": "مَوْجَةٍ"}, "tr": "dalga", "tanim_tr": "(1) Deniz ve nehir suyunun yükselip art arda gelen kısmı. (2) Radyo ve telsiz dalgası: boşlukta ve yayında ilerleyen titreşimler.", "ornekler_tr": ["“Deniz dalgaları gemiyi karaya attı.”", "“Her yerden dalgalar onlara geldi.”", "“Yayın orta dalgadan yapılıyor.”"], "resim": "p345_1.jpg", "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مُوجَز", "cogul": null, "metin": "خُلاصَةُ المَقالِ أَوِ الكَلام . “اسْتَمَعْتُ إِلى مُوجَزِ الأَنْباء” .", "tanim": "خُلاصَةُ المَقالِ أَوِ الكَلام", "ornekler": ["“اسْتَمَعْتُ إِلى مُوجَزِ الأَنْباء”"], "bosluk": {"cumle": "اسْتَمَعْتُ إِلى مُوجَزِ الأَنْباء", "kelime": "مُوجَزِ"}, "tr": "özet", "tanim_tr": "Yazının ya da sözün özeti.", "ornekler_tr": ["“Haber özetini dinledim.”"], "resim": "p345_2.jpg", "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مُوَجَّه", "cogul": null, "metin": "مُرْسَل . “هٰذِهِ رِسالَةٌ مُوَجَّهَةٌ إِلى والِدي” .", "tanim": "مُرْسَل", "ornekler": ["“هٰذِهِ رِسالَةٌ مُوَجَّهَةٌ إِلى والِدي”"], "bosluk": {"cumle": "هٰذِهِ رِسالَةٌ مُوَجَّهَةٌ إِلى والِدي", "kelime": "مُوَجَّهَةٌ"}, "tr": "yöneltilmiş, gönderilmiş", "tanim_tr": "Gönderilmiş.", "ornekler_tr": ["“Bu, babama gönderilmiş bir mektuptur.”"], "resim": null, "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مَوْجود", "cogul": null, "metin": "حاضِر ؛ خِلافُ غائِبٍ وَمَعْدوم ، “عِنْدَما وَصَلْتُ إِلى المَوْقِفِ ، كانَتِ الحافِلَةُ مَوْجودَةً” ، “جَميعُ الطُّلاّبِ مَوْجودونَ في الصَّفِّ” .", "tanim": "حاضِر ؛ خِلافُ غائِبٍ وَمَعْدوم", "ornekler": ["“عِنْدَما وَصَلْتُ إِلى المَوْقِفِ ، كانَتِ الحافِلَةُ مَوْجودَةً”", "“جَميعُ الطُّلاّبِ مَوْجودونَ في الصَّفِّ”"], "bosluk": {"cumle": "جَميعُ الطُّلاّبِ مَوْجودونَ في الصَّفِّ", "kelime": "مَوْجودونَ"}, "tr": "mevcut, var olan", "tanim_tr": "Hazır bulunan; gaib ve yok olanın zıddı.", "ornekler_tr": ["“Durağa vardığımda otobüs oradaydı.”", "“Bütün öğrenciler sınıfta mevcut.”"], "resim": "p345_3.jpg", "not": "Sütunun son satırı taramada alttan kesik; “مَوْجودَةً” ، “جَميعُ الطُّلاّبِ مَوْجودونَ في الصَّفِّ” kısmı ve harekeleri tahminî."},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مُوَحَّد", "cogul": null, "metin": "مُتَّفِق ؛ خِلافُ مُخْتَلِف ، واحِد ، “يَلْبَسُ تَلاميذُ المَرْحَلَةِ الابْتِدائِيَّةِ زِيّاً مُوَحَّداً” ، “يَجْلِسُ الطُّلاّبُ لِاخْتِبارٍ مُوَحَّدٍ في جَميعِ المَوادِّ الدِّراسِيَّة” .", "tanim": "مُتَّفِق ؛ خِلافُ مُخْتَلِف ، واحِد", "ornekler": ["“يَلْبَسُ تَلاميذُ المَرْحَلَةِ الابْتِدائِيَّةِ زِيّاً مُوَحَّداً”", "“يَجْلِسُ الطُّلاّبُ لِاخْتِبارٍ مُوَحَّدٍ في جَميعِ المَوادِّ الدِّراسِيَّة”"], "bosluk": {"cumle": "يَلْبَسُ تَلاميذُ المَرْحَلَةِ الابْتِدائِيَّةِ زِيّاً مُوَحَّداً", "kelime": "مُوَحَّداً"}, "tr": "birleşik, tek tip", "tanim_tr": "Uyumlu, aynı; farklının zıddı; tek.", "ornekler_tr": ["“İlkokul öğrencileri tek tip kıyafet giyer.”", "“Öğrenciler bütün derslerde ortak bir sınava girer.”"], "resim": "p345_4.jpg", "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مُوحِش", "cogul": null, "metin": "(١) لا نَباتَ وَلا حَياةَ فيه ، “أَصْبَحَتْ أَرْضُنا مُوحِشَةً ، بَعْدَ انْقِطاعِ المَطَر” . (٢) مُخيف ، “هٰذِهِ طَريقٌ مُوحِشَة” .", "tanim": "(١) لا نَباتَ وَلا حَياةَ فيه (٢) مُخيف", "ornekler": ["“أَصْبَحَتْ أَرْضُنا مُوحِشَةً ، بَعْدَ انْقِطاعِ المَطَر”", "“هٰذِهِ طَريقٌ مُوحِشَة”"], "bosluk": {"cumle": "هٰذِهِ طَريقٌ مُوحِشَة", "kelime": "مُوحِشَة"}, "tr": "ıssız, ürkütücü", "tanim_tr": "(1) İçinde bitki ve hayat olmayan. (2) Korkutucu.", "ornekler_tr": ["“Yağmurlar kesilince toprağımız ıssızlaştı.”", "“Bu ürkütücü bir yol.”"], "resim": "p345_5.jpg", "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مَوَدَّة", "cogul": null, "metin": "مَحَبَّة ، “بَيْنَنا وَبَيْنَ مُعَلِّمينا مَوَدَّة” ، ﴿وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً﴾ .", "tanim": "مَحَبَّة", "ornekler": ["“بَيْنَنا وَبَيْنَ مُعَلِّمينا مَوَدَّة”", "﴿وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً﴾"], "bosluk": {"cumle": "بَيْنَنا وَبَيْنَ مُعَلِّمينا مَوَدَّة", "kelime": "مَوَدَّة"}, "tr": "sevgi", "tanim_tr": "Sevgi.", "ornekler_tr": ["“Bizimle öğretmenlerimiz arasında sevgi var.”", "“Aranıza sevgi ve merhamet koydu.”"], "resim": null, "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مُودَع", "cogul": null, "metin": "مَحْفوظٌ ، مَصونٌ ، “لَهُ أَمْوالٌ كَثيرَةٌ مُودَعَةٌ في المَصْرِف” .", "tanim": "مَحْفوظٌ ، مَصونٌ", "ornekler": ["“لَهُ أَمْوالٌ كَثيرَةٌ مُودَعَةٌ في المَصْرِف”"], "bosluk": {"cumle": "لَهُ أَمْوالٌ كَثيرَةٌ مُودَعَةٌ في المَصْرِف", "kelime": "مُودَعَةٌ"}, "tr": "emanet edilmiş, yatırılmış", "tanim_tr": "Korunan, saklanan.", "ornekler_tr": ["“Onun bankaya yatırılmış çok parası var.”"], "resim": null, "not": null},
 {"sayfa": 345, "baski_no": "٣٤٥", "k": "مَوْرِد", "cogul": "مَوارِد", "metin": "(ج) مَوارِد : مَنْهَل ، طَريق ، “أَيْنَ مَوْرِدُ المِياهِ في هٰذِهِ القَرْيَة ؟” ، وَفي الحَديث : (اتَّقوا المَلاعِنَ الثَّلاثَ : البِرازَ في المَوارِدِ وَقارِعَةِ الطَّريقِ وَالظِّلِّ) .", "tanim": "مَنْهَل ، طَريق", "ornekler": ["“أَيْنَ مَوْرِدُ المِياهِ في هٰذِهِ القَرْيَة ؟”", "(اتَّقوا المَلاعِنَ الثَّلاثَ : البِرازَ في المَوارِدِ وَقارِعَةِ الطَّريقِ وَالظِّلِّ)"], "bosluk": {"cumle": "أَيْنَ مَوْرِدُ المِياهِ في هٰذِهِ القَرْيَة ؟", "kelime": "مَوْرِدُ"}, "tr": "su kaynağı; kaynak", "tanim_tr": "Su içilen yer, yol.", "ornekler_tr": ["“Bu köyde su kaynağı nerede?”", "“Lanete sebep olan üç şeyden sakının: su kaynaklarına, yol ortasına ve gölgeliğe abdest bozmak.” (hadis)"], "resim": null, "not": null},
