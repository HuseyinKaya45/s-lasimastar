# Evlilik Tanıştırma Sistemi — örnek yapılandırma. Kopyalayıp .env olarak kaydedin (chmod 600).

# `npm run keygen` çıktısıyla değiştirin. Anahtarı yedekten AYRI saklayın; kaybolursa veriler kurtarılamaz.
DATA_KEYS=1:BURAYA_32_BAYTLIK_BASE64_ANAHTAR
DATA_KEY_ID=1

DATA_DIR=/var/lib/ets
HOST=127.0.0.1
PORT=8080

# HTTPS sonlandıran ters vekil (nginx vb.) arkasında:
TRUST_PROXY=1
# Veya sunucu doğrudan HTTPS sunacaksa:
# TLS_CERT=/etc/ets/tls/fullchain.pem
# TLS_KEY=/etc/ets/tls/privkey.pem

SESSION_MAX_HOURS=12
# Üretimde KAPALI olmalı:
ALLOW_DEMO=0

# --- Merkezî eşleştirme (isteğe bağlı; README §0.b) ---
# Birim tarafı:
# UNIT_ENC_KEY_FILE=/etc/ets/keys/unit-enc.pem
# AUTHORITY_ENC_PUBKEY_FILE=/etc/ets/keys/authority-enc-public.pem
# Otorite sunucusu (authority-server.js):
# AUTHORITY_DATA_DIR=/var/lib/ets-otorite
# AUTHORITY_SIGNING_KEY_FILE=/etc/ets/keys/authority-private.pem
# AUTHORITY_KEY_PASSPHRASE=
# AUTHORITY_ENC_KEY_FILE=/etc/ets/keys/authority-enc-private.pem
